# Lock files (exist only while a file is open)
*.lck
~*.lck

# Caches and per-user view settings
fp-info-cache
*.kicad_prl

# Fabrication / export output (regenerate from the PCB when needed)
gerbers/
Gerbers/
fab/
production/
*.gbr
*.drl
*-job.gbrjob
*.pos
*-drc.rpt
*-erc.rpt

